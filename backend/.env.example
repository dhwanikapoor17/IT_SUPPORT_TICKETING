DATABASE_URL=postgresql+psycopg2://postgres:your_db_password@localhost:5432/it_support_db
SECRET_KEY=generate_a_secure_32_byte_secret_key_here

# ==============================================================================
# SMTP Email Notification Configuration (Google Workspace / Microsoft 365 / SES)
# If left blank, notifications are automatically logged to email_notifications.log
# ==============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=techsupport@yourcompany.com
SMTP_PASSWORD=your_16_character_app_password
SMTP_FROM_EMAIL=techsupport@yourcompany.com
SMTP_FROM_NAME="IT Support Desk"
SMTP_USE_TLS=True

# Admin recipient for new ticket alerts
ADMIN_EMAIL=admin@yourcompany.com
